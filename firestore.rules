rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidBoundedStringList(arr, maxLen) {
      return arr is list &&
             arr.size() <= maxLen &&
             (arr.size() == 0 || arr[0] is string);
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
             (!('professionGroup' in data) || data.professionGroup == null || (data.professionGroup is string && data.professionGroup.size() <= 60)) &&
             (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 80)) &&
             data.cyclePreset is string && data.cyclePreset.size() >= 1 && data.cyclePreset.size() <= 48 &&
             isValidIsoDate(data.referenceStartDate) &&
             (!('customSequence' in data) || data.customSequence == null || isValidBoundedStringList(data.customSequence, 31)) &&
             data.appLanguage is string && data.appLanguage in ['system', 'tr', 'en'] &&
             data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidShiftOverride(data, dateKey) {
      return data.userId is string && data.userId == request.auth.uid &&
             isValidIsoDate(data.dateIso) && data.dateIso == dateKey &&
             data.shiftType is string && data.shiftType in ['GUNDUZ', 'GECE', 'SABAH', 'AKSAM', 'GECE8', 'IZIN', 'RAPOR', 'NOBET24'] &&
             (data.overtimeHours is int || data.overtimeHours is float) &&
             data.overtimeHours >= 0 && data.overtimeHours <= 24 &&
             data.note is string && data.note.size() <= 500 &&
             (!('customStartTime' in data) || data.customStartTime == null || (data.customStartTime is string && data.customStartTime.size() <= 10)) &&
             (!('customEndTime' in data) || data.customEndTime == null || (data.customEndTime is string && data.customEndTime.size() <= 10)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidColleague(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.department is string && data.department.size() <= 80 &&
             data.cyclePreset is string && data.cyclePreset.size() >= 1 && data.cyclePreset.size() <= 48 &&
             isValidIsoDate(data.referenceStartDate) &&
             (!('customSequence' in data) || data.customSequence == null || isValidBoundedStringList(data.customSequence, 31)) &&
             data.sourceLabel is string && data.sourceLabel.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'department', 'cyclePreset',
                         'referenceStartDate', 'appLanguage', 'schemaVersion',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'department',
                         'professionGroup', 'title', 'cyclePreset',
                         'referenceStartDate', 'customSequence', 'appLanguage',
                         'schemaVersion', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'department', 'professionGroup',
                         'title', 'cyclePreset', 'referenceStartDate',
                         'customSequence', 'appLanguage', 'schemaVersion', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);

      // --- /users/{userId}/shift_overrides/{dateKey} ---
      match /shift_overrides/{dateKey} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(dateKey) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(dateKey) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateIso', 'shiftType', 'overtimeHours',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateIso', 'shiftType', 'overtimeHours',
                           'note', 'customStartTime', 'customEndTime',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidShiftOverride(incoming(), dateKey);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(dateKey) &&
                         isOwner(userId) &&
                         isValidShiftOverride(incoming(), dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateIso == existing().dateIso &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'shiftType', 'overtimeHours', 'note',
                           'customStartTime', 'customEndTime', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(dateKey) && isOwner(userId);
      }

      // --- /users/{userId}/colleagues/{colleagueId} ---
      match /colleagues/{colleagueId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(colleagueId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(colleagueId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'department', 'cyclePreset',
                           'referenceStartDate', 'sourceLabel',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'department', 'cyclePreset',
                           'referenceStartDate', 'customSequence', 'sourceLabel',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidColleague(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(colleagueId) &&
                         isOwner(userId) &&
                         isValidColleague(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'department', 'cyclePreset',
                           'referenceStartDate', 'customSequence', 'sourceLabel', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(colleagueId) && isOwner(userId);
      }
    }
  }
}
